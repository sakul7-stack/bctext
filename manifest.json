{
  "manifest_version": 3,
  "name": "BCT Notes PDF Downloader",
  "version": "1.0.0",
  "description": "Adds a Download PDF button to bctnotes.com note pages so you can save notes as PDFs.",
  "permissions": ["downloads", "storage", "webRequest"],
  "host_permissions": [
    "https://bctnotes.com/*",
    "https://*.r2.cloudflarestorage.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "content_scripts": [
    {
      "matches": ["https://bctnotes.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "BCT Notes PDF Downloader",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bctnotes-downloader@bctext",
      "strict_min_version": "121.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
